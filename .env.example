APP_ENV=development
RUNTIME_MODE=live
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lectio_user:REPLACE_ME@localhost:5432/lectio_db
POSTGRES_DB=lectio_db
POSTGRES_USER=lectio_user
POSTGRES_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
ARTIFACT_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50
PARSER_TIMEOUT_SECONDS=60
WORKFLOW_TIMEOUT_SECONDS=600
MAX_CONCURRENT_RUNS=2
BACKEND_URL=http://127.0.0.1:8000

RETRIEVAL_BACKEND=neural
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_AGENT_ID=
