APP_ENV=development
RUNTIME_MODE=live
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lectio_user:REPLACE_ME@localhost:5432/lectio_db
POSTGRES_DB=lectio_db
POSTGRES_USER=lectio_user
POSTGRES_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
OPENROUTER_API_KEY=
# Free models (no credit needed). With a paid key the project uses anthropic/claude-sonnet-5.5 and, as fallback,
# openai/gpt-6.1-terra (compared on 2026-11-15; see docs/DEVELOPMENT_PROGRESS.md).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GENERATION_AUTO_ENABLED=true
# One draft per distinct gap, up to this many per audit (each is one or two model calls; on the free tier use 4)
GENERATION_MAX_ITEMS_PER_RUN=20
GENERATION_CONCURRENCY=4
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
EMBEDDING_DEVICE=cpu
ARTIFACT_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50
PARSER_TIMEOUT_SECONDS=60
# Working time of one audit. A 13-lecture course with neural retrieval took 43-52 minutes on a laptop CPU; use 3600 for such courses.
WORKFLOW_TIMEOUT_SECONDS=600
MAX_CONCURRENT_RUNS=2
BACKEND_URL=http://127.0.0.1:8000

RETRIEVAL_BACKEND=neural
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_AGENT_ID=
