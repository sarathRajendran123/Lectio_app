FROM python:3.11-slim-bookworm

WORKDIR /app

# System dependencies for document processing + OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpoppler-cpp-dev \
    poppler-utils \
    tesseract-ocr \
    libtesseract-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only torch FIRST. sentence-transformers pulls in full GPU torch
# (+ ~3-4GB of nvidia-cuda-* wheels) by default, even though EMBEDDING_DEVICE=cpu.
# Installing the CPU wheel up front satisfies that dependency without the bloat.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install remaining Python deps (cached layer)
COPY requirements.txt .
COPY requirements-core.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Embedding/reranker weights (BAAI/bge-m3 ~2.3 GB) download on first use into the
# hf_cache volume (see docker-compose.yml): one copy, survives image rebuilds.
ENV HF_HOME=/models

# Copy application code
COPY backend/ .

# Create upload directory
RUN mkdir -p /app/uploads

EXPOSE 8000
