APP_ENV=development
RUNTIME_MODE=live
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lectio_user:REPLACE_ME@localhost:5432/lectio_db
POSTGRES_DB=lectio_db
POSTGRES_USER=lectio_user
POSTGRES_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GENERATION_AUTO_ENABLED=true
GENERATION_MAX_ITEMS_PER_RUN=4
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
EMBEDDING_DEVICE=cpu
ARTIFACT_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50
PARSER_TIMEOUT_SECONDS=60
WORKFLOW_TIMEOUT_SECONDS=600
MAX_CONCURRENT_RUNS=2
BACKEND_URL=http://127.0.0.1:8000

RETRIEVAL_BACKEND=neural
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_AGENT_ID=
