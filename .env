# ── Application ─────────────────────────────────
APP_NAME=LECTIO
APP_ENV=development           # development | production
DEBUG=true
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lectio_db
POSTGRES_USER=lectio_user
POSTGRES_PASSWORD=Umang_7625
DATABASE_URL=postgresql+asyncpg://lectio_user:change_me_strong_password@postgres:5432/lectio_db

# ── ChromaDB ─────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=lectioapp

# ── Security ─────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=cdc7f22ad98535a5e3e46265ecf6e38a346d028bfe703c21bfa477c0a746cc07f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM — GROQ (FREE TIER) ───────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile   # Free, fast, powerful

# ── LangSmith (Optional — for tracing) ───────────
# Get your key at: https://smith.langchain.com
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=lectio-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Embeddings (Local — No API key needed!) ──────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# ── File Storage ──────────────────────────────────
ARTIFACT_STORAGE_PATH=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Auto-provisioned Admin ────────────────────────
# Created automatically on backend startup if this email doesn't
# already exist in the database. Change the password below (and/or
# the one inside the running app) before this goes anywhere near
# real students or staff.
ADMIN_EMAIL=admin@lectio.ac.za
ADMIN_PASSWORD=Admin@Lectio2025!
ADMIN_FULL_NAME=System Administrator

# ── Frontend ──────────────────────────────────────
BACKEND_URL=http://backend:8000
